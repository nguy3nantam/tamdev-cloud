# Thông tin đăng nhập trang quản trị (/admin)
# Sao chép file này thành `.env` rồi điền giá trị thật.
# KHÔNG commit file `.env` — đã được gitignore.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-password
# Chuỗi bí mật dùng để ký session token, nên tạo ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-byte-hex-string
