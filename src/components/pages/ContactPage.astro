---
import { ui, type Locale } from '../../i18n';
import { contact } from '../../config/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const formAction = 'https://formsubmit.co/hello@tamdev.cloud';
---

<section class="hero" style="padding-bottom:3rem">
  <div class="container">
    <h1 class="reveal">
      {t.contact.title}<br />
      <span class="text-gradient">{t.contact.subtitle}</span>
    </h1>
    <p class="hero-sub reveal">{t.contact.intro}</p>
  </div>
</section>

<section class="section" style="padding-top:2rem">
  <div class="container">
    <div class="contact-grid">
      <div class="reveal">
        <h2 style="font-size:1.3rem">{t.contact.infoTitle}</h2>

        <div class="contact-info-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M22 7l-10 6L2 7" />
            </svg>
          </div>
          <div>
            <h3>{t.contact.emailLabel}</h3>
            <a href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </div>
          <div>
            <h3>{t.contact.phoneLabel}</h3>
            <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <div>
            <h3>{t.contact.locationLabel}</h3>
            <p>{t.contact.location}</p>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8v4l2.5 2.5" />
              <circle cx="12" cy="12" r="9" />
            </svg>
          </div>
          <div>
            <h3>{t.contact.responseTime}</h3>
          </div>
        </div>
      </div>

      <form
        class="card reveal"
        action={formAction}
        method="POST"
      >
        <input type="hidden" name="_subject" value={`[tamdev.cloud] ${locale === 'vi' ? 'Tin nhắn mới từ website' : 'New message from website'}`} />
        <h2 style="font-size:1.3rem">{t.contact.formTitle}</h2>

        <div class="form-group">
          <label for="name">{t.contact.form.name}</label>
          <input id="name" name="name" type="text" placeholder={t.contact.form.namePlaceholder} required />
        </div>

        <div class="form-group">
          <label for="email">{t.contact.form.email}</label>
          <input id="email" name="email" type="email" placeholder={t.contact.form.emailPlaceholder} required />
        </div>

        <div class="form-group">
          <label for="budget">{t.contact.form.budget}</label>
          <input id="budget" name="budget" type="text" placeholder={t.contact.form.budgetPlaceholder} />
        </div>

        <div class="form-group">
          <label for="message">{t.contact.form.message}</label>
          <textarea id="message" name="message" placeholder={t.contact.form.messagePlaceholder} required></textarea>
        </div>

        <button class="btn btn-primary" type="submit">{t.contact.form.submit}</button>
        <p class="form-note">{locale === 'vi' ? `Form được gửi qua FormSubmit — kiểm tra email ${t.contact.email} sau khi bật dịch vụ.` : `Form is sent via FormSubmit — check ${t.contact.email} once the service is activated.`}</p>
      </form>
    </div>
  </div>
</section>
