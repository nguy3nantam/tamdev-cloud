---
import Layout from '../layouts/Layout.astro';
import ServicesPage from '../components/pages/ServicesPage.astro';
import { ui } from '../i18n';

const locale = 'vi' as const;
const t = ui[locale];
---

<Layout locale={locale} pathname={Astro.url.pathname} title={t.meta.services.title} description={t.meta.services.description}>
  <ServicesPage locale={locale} />
</Layout>
